extends SceneTree
const S=preload("res://scripts/simulation.gd")
var checks=0
var failures=0
func check(ok: bool,title: String) -> void:
 checks+=1
 if ok:print("PASS: ",title)
 else:failures+=1;push_error("FAIL: "+title)
func fresh() -> WorldSimulation:
 var s=S.new();s.setup();s.reproduction="Paused";return s
func advance(s: WorldSimulation,count: int) -> void:
 for i in count:s.step()
func _initialize() -> void:
 var s=fresh();var b=fresh()
 check(s.cells.size()==32768,"world contains 32768 spherical cells, four times the original grid")
 check(s.state_hash()==b.state_hash(),"same seed produces identical world and random streams")
 check(absf(s.surface(0,0).length()-S.PLANET_RADIUS)<1,"world positions lie on the planet surface")
 check(s.normal_at(0,0).dot(s.normal_at(S.W*.5,0))<-.99,"opposite longitudes are opposite sides of the same sphere")
 check(s.cells[s.cell_at(0,-64)].ice,"poles remain impassable")
 s.paused=true;advance(s,15);check(s.tick==0,"pause freezes every simulation tick")
 s.paused=false;s.step();s.paused=true;check(s.tick==1,"single fixed tick advances exactly once")
 var p=s.people[0];s.paused=false;var before=Vector2(p.x,p.z);advance(s,10)
 check(s.distance(before,Vector2(p.x,p.z))>.5,"autonomous people move within one real second at 1x")
 s=fresh();p=s.people[0];s.order(p.id,"move",-9,2);advance(s,80)
 check(p.task=="hold" and p.authority=="God","move orders finish in persistent hold")
 var point=Vector2(p.x,p.z);advance(s,300)
 check(s.distance(point,Vector2(p.x,p.z))<.001,"orders are not overwritten by autonomous jobs")
 s.resume(p.id);advance(s,50);check(p.authority=="Auto" and p.task!="hold","explicit release restores autonomy")
 s=fresh();p=s.people[0];var total=s.grain;p.cargo=3;s.grain-=3;s.reservations[str(p.id)]="grain"
 s.possess(p.id);s.release();check(s.grain==total and p.cargo==0 and s.reservations.is_empty(),"interrupted cargo is returned exactly once")
 s.possess(p.id);s.order(p.id,"move",-9,2);check(s.possessed==-1 and p.authority=="God","new direct order releases possession without yielding to AI")
 s.possess(p.id);s.lift(p.id,-15,-2);check(s.possessed==-1 and p.task=="hold","divine lift clears possession and holds position")
 check(s.order(p.id,"build",-15,-2).contains("foundation"),"building order explains a missing foundation")
 check(s.order(p.id,"move",7,0).contains("underwater"),"unsafe destinations return a reason")
 check(s.order(p.id,"unsupported",0,0)=="Unsupported order.","unknown commands are rejected")
 s.order(p.id,"move",-14,-2);s.order(p.id,"move",-13,-2,true);check(p.queue.size()==1,"queued orders persist")
 s=fresh();var timber=s.wood;check(s.place("storehouse",-1,-1).contains("started"),"storehouse can be placed through normal commands")
 var foundation=s.buildings.back();check(s.wood==timber-18,"foundation reserves timber once")
 s.cancel_building(foundation.id);check(s.wood==timber,"cancelled foundation refunds timber")
 s.place("storehouse",-1,-1);advance(s,400)
 check(s.has_building("storehouse"),"builders travel and finish actual construction at 1x")
 check(s.harvests>0 and s.grain>0,"farmers harvest and deliver physical cargo")
 check(s.research().contains("SETTLEMENT"),"harvest and storehouse unlock the next age")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);var hp=p.health
 check(s.power("fire",p.x,p.z).contains("Confirm") and p.health==hp,"destructive calamities require confirmation")
 s.power("fire",p.x,p.z,true);advance(s,40)
 check(not p.alive and p.health==0,"unprotected wildfire kills a person within four game seconds")
 s.power("resurrect",p.x,p.z,true);check(p.alive and p.task=="hold" and p.path.is_empty(),"resurrection restores life without stale movement")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);s.power("fire",p.x,p.z,true);s.power("rain",p.x,p.z,true);advance(s,40)
 check(p.alive and s.cells[s.cell_at(p.x,p.z)].fire==0,"rain extinguishes fire and prevents further burning")
 var wet=s.cells[s.cell_at(-6,0)];s.power("fire",-6,0,true)
 check(wet.fire==0,"wet ground resists reignition")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);s.power("shield",p.x,p.z,true);s.power("fire",p.x,p.z,true);s.power("lightning",p.x,p.z,true);advance(s,40)
 check(p.alive and p.health==100,"shield protects against ignition and lightning")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);s.power("flood",p.x,p.z,true);advance(s,100)
 check(not p.alive,"a deep deluge drowns unprotected people")
 s=fresh();p=s.people[0];p.x=-4;p.z=0;s.order(p.id,"hold",-4,0)
 for x in range(-8,-2):s.cells[s.cell_at(x,0)].water=.4;s.active_cells[s.cell_at(x,0)]=true
 s.power("lightning",-8,0,true)
 check(s.cells[s.cell_at(-4,0)].electric>s.tick and p.health<100,"lightning travels beyond its direct radius through connected water")
 advance(s,10);check(not p.alive,"conducted lightning is lethal to a person standing in connected water")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);s.power("quake",p.x,p.z,true)
 check(p.health<40 and s.buildings[0].health<100,"earthquake injures people and damages nearby buildings")
 s.power("meteor",p.x,p.z,true);check(not p.alive,"meteor impact has immediate lethal consequences")
 s=fresh();p=s.people[0];s.order(p.id,"hold",p.x,p.z);s.power("tornado",p.x,p.z,true);advance(s,100)
 check(not p.alive,"tornado force and exposure cause lethal injuries")
 s=fresh();s.power("rain",-6,0,true);var water_before=0.0
 for c in s.cells:water_before+=c.water
 advance(s,5);var water_after=0.0
 for c in s.cells:water_after+=c.water
 check(water_after<=water_before+.001 and water_after>water_before-1,"water transfer conserves volume apart from explicit evaporation")
 s=fresh();s.sandbox=false;s.energy=0;check(s.power("rain",0,0).contains("Not enough"),"challenge enforces faith costs");s.step();check(s.energy>0,"faith regenerates from a fixed baseline")
 s=fresh();check(s.animals.size()==8,"dogs, cats and wild deer are simulated")
 var pet=s.animals[0];pet.mode="Stay";var loc=Vector2(pet.x,pet.z);advance(s,50);check(Vector2(pet.x,pet.z)==loc,"pet stay command persists")
 pet.mode="Follow";s.lift(pet.owner,-14,0);advance(s,50);check(Vector2(pet.x,pet.z).distance_to(loc)>.5,"pet follows its assigned person")
 s.power("lightning",pet.x,pet.z,true);check(not pet.alive,"animals are vulnerable to disasters")
 s.power("resurrect",pet.x,pet.z,true);check(pet.alive,"animal resurrection works")
 s=fresh();var a=s.people[0];var partner=s.people[1]
 check(s.arrange_pair(a.id,partner.id).contains("expected"),"god can pair two adults")
 var count=s.people.size();check(s.bless_birth(a.id).contains("born"),"god can bless an immediate birth")
 var baby=s.people.back();check(s.people.size()==count+1 and baby.age==0 and baby.parents==[a.id,partner.id],"birth creates a persistent child with parent IDs")
 check(s.arrange_pair(baby.id,a.id).contains("adults"),"children cannot reproduce")
 s.arrange_pair(a.id,partner.id);var due=a.pregnancy if a.pregnancy>0 else partner.pregnancy;s.reproduction="Paused";s.tick=due-1;advance(s,5)
 check(s.people.size()==count+1,"paused reproduction blocks an otherwise due birth")
 s.reproduction="Natural";advance(s,100);check(s.people.size()==count+2,"resuming reproduction permits the due birth")
 s.arrange_pair(a.id,partner.id);s.cancel_birth(a.id);check(a.pregnancy==0 and partner.pregnancy==0,"god can cancel the expected birth")
 s=fresh();s.power("rain",-6,0,true);s.power("fire",-12,2,true);advance(s,25);s.arrange_pair(s.people[0].id,s.people[1].id)
 var before_hash=s.state_hash();check(s.save_world("user://v2-test.json"),"version 2 world saves")
 b=S.new();check(b.load_world("user://v2-test.json"),"version 2 world loads")
 check(before_hash==b.state_hash(),"lossless save preserves all people, animals, pregnancies and physics fields")
 advance(s,120);advance(b,120);check(s.state_hash()==b.state_hash(),"resumed elemental simulation matches uninterrupted run")
 var bad=s.snapshot().duplicate(true);bad.people[0].path=[-1];var hash=s.state_hash()
 check(not s.restore(bad) and hash==s.state_hash(),"malformed path is rejected before changing live state")
 bad=s.snapshot().duplicate(true);bad.buildings[0].x="broken";check(not s.restore(bad) and hash==s.state_hash(),"malformed building coordinates are rejected atomically")
 s.save_world("user://v2-test.json");s.save_world("user://v2-test.json");var file=FileAccess.open("user://v2-test.json",FileAccess.WRITE);file.store_string("broken");file.close();check(b.load_world("user://v2-test.json"),"corrupt primary save recovers backup")
 s=fresh();s.diplomacy("trade");s.diplomacy("treaty");s.save_world("user://treaty-v2.json");b=S.new();b.load_world("user://treaty-v2.json");check(b.treaty,"treaty survives save/load")
 s=fresh()
 for p2 in s.people:s.order(p2.id,"hold",p2.x,p2.z)
 s.place("storehouse",-14,-8);var first=s.buildings.back();s.place("home",-18,-8);var second=s.buildings.back();p=s.people[0]
 s.order(p.id,"build",first.x,first.z);var target_id=p.target_id;s.order(p.id,"build",second.x,second.z,true)
 check(p.target_id==target_id,"queueing construction never changes the active construction target")
 advance(s,140)
 check(first.work>0 and second.work==0,"a queued foundation is not built remotely while working on the first")
 s=fresh()
 for p2 in s.people:s.order(p2.id,"hold",p2.x,p2.z)
 s.place("storehouse",-14,-8);first=s.buildings.back();p=s.people[0];s.order(p.id,"build",first.x,first.z)
 var obstacle=p.path[0];s.cells[obstacle].fire=1.0;s.cells[obstacle].fuel=8.0;s.active_cells[obstacle]=true;s.step();s.cells[obstacle].fire=0.0
 advance(s,180)
 check(first.work>0,"blocked construction resumes construction rather than becoming a move order")
 s=fresh();p=s.people[0];s.order(p.id,"move",-8,-1);s.order(p.id,"move",-14,-8,true);s.cells[s.cell_at(-14,-8)].water=2
 advance(s,8)
 check(p.queue.size()==1 and p.task=="blocked_queue" and not p.blocked.is_empty(),"blocked queued orders retain intent and an explanation")
 s=fresh();pet=s.animals[0];s.power("shield",pet.x,pet.z,true);s.power("lightning",pet.x,pet.z,true)
 check(pet.alive and pet.health==100,"shield protects pets against direct lightning")
 s.power("meteor",pet.x,pet.z,true);check(pet.alive,"shield protects pets against a meteor")
 bad=s.snapshot().duplicate(true);bad.animals[0].target=["bad",0];hash=s.state_hash()
 check(not s.restore(bad) and hash==s.state_hash(),"malformed animal movement targets are rejected atomically")
 s=fresh();var farm=s.buildings[3];s.power("drought",farm.x,farm.z,true)
 check(s.cells[s.cell_at(farm.x,farm.z)].dry_until>s.tick,"drought persists and suppresses farm work")
 s.power("rain",farm.x,farm.z,true)
 check(s.cells[s.cell_at(farm.x,farm.z)].dry_until==0,"rain restores drought-stricken farm soil")
 s=fresh();b=fresh();s.order(s.people[0].id,"move",-12,3);b.order(b.people[0].id,"move",-12,3)
 advance(s,160)
 for i in 10:advance(b,16)
 check(s.state_hash()==b.state_hash(),"1x and 16x tick batching preserve identical commands and world state")
 check(s.pathfind(s.cell_at(-10,0),s.cell_at(-8,-5)).is_empty(),"routes cannot enter a solid building footprint")
 s.possess(s.people[0].id);s.people[0].x=-8;s.people[0].z=-4;s.manual_move(0,-1)
 check(s.people[0].z==-4,"possession collides with building footprints")
 check(s.water_radius({"e":.4,"water":1.65})>S.PLANET_RADIUS+1.5,"deep water is rendered deep enough to submerge a person")
 s=fresh();var house=s.buildings[0];s.power("fire",house.x,house.z,true);advance(s,80)
 check(house.health<100,"wildfire damages actual structures")
 s.power("rain",house.x,house.z,true);s.power("heal",house.x,house.z,true)
 check(house.health==100,"healing repairs structures after a calamity")
 s=fresh();s.evacuate();advance(s,350);s.flood=1.25;advance(s,180)
 check(s.alive_count()==12,"evacuation reaches a genuinely flood-safe refuge without artificial platforms")
 print("RESULT: %d checks, %d failures"%[checks,failures]);quit(1 if failures>0 else 0)
