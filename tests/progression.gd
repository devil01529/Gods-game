extends SceneTree
func _initialize() -> void:
 var s=WorldSimulation.new(); s.setup()
 assert(s.place("storehouse",-2,-2).begins_with("Construction"))
 assert(s.place("levee",3,0).begins_with("Construction"))
 for i in 400: s.step()
 assert(s.research().contains("SETTLEMENT"))
 assert(s.place("market",-11,5).begins_with("Construction"))
 assert(s.place("workshop",-1,3).begins_with("Construction"))
 s.diplomacy("trade"); s.diplomacy("treaty")
 for i in 500: s.step()
 assert(s.research().contains("INDUSTRY"))
 assert(s.place("windmill",-11,-5).begins_with("Construction"))
 for i in 1300: s.step()
 assert(s.research().contains("PLANETARY"))
 assert(s.place("observatory",-1,-6).begins_with("Construction"))
 for i in 19500: s.step()
 assert(s.has_building("observatory"))
 assert(s.outcome=="Stewardship complete")
 print("PROGRESSION_PASS: all four eras, trade, treaty, clean energy, observatory, and two connected sites supplied for one uninterrupted year; tick=%d survivors=%d"%[s.tick,s.alive_count()])
 quit()
